<UserControl x:Class="SystemCleaner.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32"
                    Orientation="Vertical">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,24">
        <Border Width="288"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Margin="0,0,16,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.12" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Width="32"
                                   Height="32"
                                   Margin="0,0,12,0"
                                   Source="https://img.icons8.com/ios-filled/50/415a77/clock.png" />
                            <TextBlock Text="Last Scan"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Cleanup.LastScanSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,8,0,0" />
                        <Button Content="Rescan"
                                Width="124"
                                Height="36"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource AccentButtonStyle}"
                            Command="{Binding Cleanup.ScanCommand}" />
                    </StackPanel>
                </Border>

        <Border Width="288"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.12" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Width="32"
                                   Height="32"
                                   Margin="0,0,12,0"
                                   Source="https://img.icons8.com/ios-filled/50/43a047/flash-on.png" />
                            <TextBlock Text="Quick Clean"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Cleanup.LastQuickCleanSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,8,0,0" />
                        <Button Content="Clean Now"
                                Width="124"
                                Height="36"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource AccentButtonStyle}"
                            Command="{Binding Cleanup.QuickCleanCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Installed Apps"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Uninstaller.Applications.Count, StringFormat={}{0:N0}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Catalog entries"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="12,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Startup Items"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding StartupManager.Entries.Count, StringFormat={}{0:N0}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Boot programs"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="12,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Browser Extensions"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Uninstaller.BrowserExtensions.Count, StringFormat={}{0:N0}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Tracked extensions"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Cleanup Items"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Cleanup.PendingCleanupItemCount, StringFormat={}{0:N0}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Pending files"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="System Uptime"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding SystemInfo.UptimeDisplay}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Last Boot"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding SystemInfo.LastBootDisplay}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

        <Border Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="System Usage"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Current CPU and GPU activity updates every few seconds."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,16" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SystemUsage.Cpu.Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Grid Margin="0,16,0,0"
                              HorizontalAlignment="Center"
                              DataContext="{Binding SystemUsage.Cpu}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTelemetry}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid Width="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Height="190"
                                      Tag="100">
                                    <Ellipse Fill="{DynamicResource SurfaceBrush}"
                                             Stroke="{DynamicResource BorderBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse Width="150"
                                             Height="150"
                                             Fill="{DynamicResource GaugeInnerBrush}"
                                             Stroke="{DynamicResource GaugeInnerStrokeBrush}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.22">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="Tag"
                                                     RelativeSource="{RelativeSource AncestorType=Grid}"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="UsagePercent"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:F0}%}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                        <TextBlock Grid.Row="1"
                                                   Text="Utilization"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>

                        <StackPanel Margin="0,18,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    DataContext="{Binding SystemUsage.Cpu}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTelemetry}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel>
                                <TextBlock Text="Temperature"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TemperatureDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="24,0,24,0">
                                <TextBlock Text="Clock"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FrequencyDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Power"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PowerDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding SystemUsage.Cpu.TelemetryStatus}"
                                   Margin="0,20,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarningTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemUsage.Cpu.HasTelemetry}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="12,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SystemUsage.Gpu.Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Grid Margin="0,16,0,0"
                              HorizontalAlignment="Center"
                              DataContext="{Binding SystemUsage.Gpu}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTelemetry}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid Width="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Height="190"
                                      Tag="100">
                                    <Ellipse Fill="{DynamicResource SurfaceBrush}"
                                             Stroke="{DynamicResource BorderBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse Width="150"
                                             Height="150"
                                             Fill="{DynamicResource GaugeInnerBrush}"
                                             Stroke="{DynamicResource GaugeInnerStrokeBrush}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.22">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="Tag"
                                                     RelativeSource="{RelativeSource AncestorType=Grid}"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="UsagePercent"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:F0}%}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                        <TextBlock Grid.Row="1"
                                                   Text="Utilization"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>

                        <StackPanel Margin="0,18,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    DataContext="{Binding SystemUsage.Gpu}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTelemetry}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel>
                                <TextBlock Text="Temperature"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TemperatureDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="24,0,24,0">
                                <TextBlock Text="Clock"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FrequencyDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Memory Freq"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding MemoryFrequencyDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding SystemUsage.Gpu.TelemetryStatus}"
                                   Margin="0,20,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WarningTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemUsage.Gpu.HasTelemetry}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Memory"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Grid Margin="0,16,0,0"
                              HorizontalAlignment="Center"
                              DataContext="{Binding SystemUsage.Memory}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTelemetry}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid Width="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Height="190"
                                      Tag="100">
                                    <Ellipse Fill="{DynamicResource SurfaceBrush}"
                                             Stroke="{DynamicResource BorderBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse Width="150"
                                             Height="150"
                                             Fill="{DynamicResource GaugeInnerBrush}"
                                             Stroke="{DynamicResource GaugeInnerStrokeBrush}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.22">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="Tag"
                                                     RelativeSource="{RelativeSource AncestorType=Grid}"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="UsagePercent"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:F0}%}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                        <TextBlock Grid.Row="1"
                                                   Text="Usage"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>

                        <StackPanel Margin="0,18,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    DataContext="{Binding SystemUsage.Memory}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTelemetry}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel>
                                <TextBlock Text="Used"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding UsedDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="24,0,24,0">
                                <TextBlock Text="Available"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding AvailableDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Total"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TotalDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Memory telemetry unavailable."
                                   Margin="0,20,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemUsage.Memory.HasTelemetry}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="10"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Storage"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding SystemInfo.LogicalDrives}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <Grid x:Name="UsageTrack"
                                                  Height="10"
                                                  Margin="0,6,0,0">
                                                <Border Background="#142032"
                                                        CornerRadius="6" />
                                                <Border Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PercentToActualWidthConverter}">
                                                            <Binding ElementName="UsageTrack" Path="ActualWidth" />
                                                            <Binding Path="UsagePercent" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:F0}% used}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Free"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Total"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Free}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding Total}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ItemsControl.Template>
                            </ItemsControl>
                            <TextBlock Text="No drives detected."
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SystemInfo.LogicalDrives.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Modules at a Glance"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Cleanup.ModuleSummaries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"
                                     Rows="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8"
                                Padding="16"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Cleanup.LastScanSummary}"
                                           FontSize="12"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding LastScannedDisplay}"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
