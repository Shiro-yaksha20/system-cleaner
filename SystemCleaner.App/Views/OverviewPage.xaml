<UserControl x:Class="SystemCleaner.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32"
                    Orientation="Vertical">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,24">
        <Border Width="288"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Margin="0,0,16,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.12" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Width="32"
                                   Height="32"
                                   Margin="0,0,12,0"
                                   Source="https://img.icons8.com/ios-filled/50/415a77/clock.png" />
                            <TextBlock Text="Last Scan"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastScanSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,8,0,0" />
                        <Button Content="Rescan"
                                Width="124"
                                Height="36"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding ScanCommand}" />
                    </StackPanel>
                </Border>

        <Border Width="288"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.12" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Width="32"
                                   Height="32"
                                   Margin="0,0,12,0"
                                   Source="https://img.icons8.com/ios-filled/50/43a047/flash-on.png" />
                            <TextBlock Text="Quick Clean"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastQuickCleanSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,8,0,0" />
                        <Button Content="Clean Now"
                                Width="124"
                                Height="36"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding QuickCleanCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

        <Border Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="System Usage"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Current CPU and GPU activity updates every few seconds."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,16" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SystemUsage.Cpu.Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Grid Margin="0,16,0,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="190"
                                  DataContext="{Binding SystemUsage.Cpu}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Height="190"
                                      Tag="100">
                                    <Ellipse Fill="{DynamicResource SurfaceBrush}"
                                             Stroke="{DynamicResource BorderBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse Width="150"
                                             Height="150"
                                             Fill="{DynamicResource GaugeInnerBrush}"
                                             Stroke="{DynamicResource GaugeInnerStrokeBrush}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.22">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="Tag"
                                                     RelativeSource="{RelativeSource AncestorType=Grid}"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="UsagePercent"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:F0}%}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                        <TextBlock Grid.Row="1"
                                                   Text="Utilization"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,16,0,0">
                                    <Border Padding="12,8"
                                            CornerRadius="14"
                                            Background="{DynamicResource GaugeInfoPillBrush}"
                                            BorderBrush="{DynamicResource GaugeInfoPillBorderBrush}"
                                            BorderThickness="1"
                                            Opacity="0.82">
                                        <StackPanel>
                                            <TextBlock Text="Temperature"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding TemperatureCelsius, StringFormat={}{0:F1} °C}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12,8"
                                            Margin="12,0,0,0"
                                            CornerRadius="14"
                                            Background="{DynamicResource GaugeInfoPillBrush}"
                                            BorderBrush="{DynamicResource GaugeInfoPillBorderBrush}"
                                            BorderThickness="1"
                                            Opacity="0.82">
                                        <StackPanel>
                                            <TextBlock Text="Clock"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding FrequencyMhz, StringFormat={}{0:F0} MHz}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                    <Grid Grid.Column="1"
                                  Margin="36,0,0,0"
                                  VerticalAlignment="Center"
                                  MinWidth="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Memory Frequency"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Cpu.MemoryFrequencyMhz, StringFormat={}{0:F0} MHz}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1"
                                           Text="Voltage"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Cpu.VoltageMillivolts, StringFormat={}{0:F0} mV}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Text="Power"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Cpu.PowerWatts, StringFormat={}{0:F0} W}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="3"
                                           Text="Core Clock"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Cpu.FrequencyMhz, StringFormat={}{0:F0} MHz}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SystemUsage.Gpu.Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Grid Margin="0,16,0,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="190"
                                  DataContext="{Binding SystemUsage.Gpu}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Height="190"
                                      Tag="100">
                                    <Ellipse Fill="{DynamicResource SurfaceBrush}"
                                             Stroke="{DynamicResource BorderBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse Width="150"
                                             Height="150"
                                             Fill="{DynamicResource GaugeInnerBrush}"
                                             Stroke="{DynamicResource GaugeInnerStrokeBrush}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.22">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="Tag"
                                                     RelativeSource="{RelativeSource AncestorType=Grid}"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Path Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.RenderTransform>
                                            <TranslateTransform X="20" Y="20" />
                                        </Path.RenderTransform>
                                        <Path.Data>
                                            <Binding Path="UsagePercent"
                                                     Converter="{StaticResource UsagePercentToArcConverter}"
                                                     ConverterParameter="150" />
                                        </Path.Data>
                                    </Path>
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:F0}%}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                        <TextBlock Grid.Row="1"
                                                   Text="Utilization"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,16,0,0">
                                    <Border Padding="12,8"
                                            CornerRadius="14"
                                            Background="{DynamicResource GaugeInfoPillBrush}"
                                            BorderBrush="{DynamicResource GaugeInfoPillBorderBrush}"
                                            BorderThickness="1"
                                            Opacity="0.82">
                                        <StackPanel>
                                            <TextBlock Text="Temperature"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding TemperatureCelsius, StringFormat={}{0:F1} °C}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12,8"
                                            Margin="12,0,0,0"
                                            CornerRadius="14"
                                            Background="{DynamicResource GaugeInfoPillBrush}"
                                            BorderBrush="{DynamicResource GaugeInfoPillBorderBrush}"
                                            BorderThickness="1"
                                            Opacity="0.82">
                                        <StackPanel>
                                            <TextBlock Text="Clock"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding FrequencyMhz, StringFormat={}{0:F0} MHz}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                    <Grid Grid.Column="1"
                        Margin="36,0,0,0"
                        VerticalAlignment="Center"
                        MinWidth="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Memory Frequency"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Gpu.MemoryFrequencyMhz, StringFormat={}{0:F0} MHz}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1"
                                           Text="Voltage"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Gpu.VoltageMillivolts, StringFormat={}{0:F0} mV}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2"
                                           Text="Power"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Gpu.PowerWatts, StringFormat={}{0:F0} W}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="3"
                                           Text="Core Clock"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding SystemUsage.Gpu.FrequencyMhz, StringFormat={}{0:F0} MHz}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="10"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Storage"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding SystemInfo.LogicalDrives}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <Grid x:Name="UsageTrack"
                                                  Height="10"
                                                  Margin="0,6,0,0">
                                                <Border Background="#142032"
                                                        CornerRadius="6" />
                                                <Border Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PercentToActualWidthConverter}">
                                                            <Binding ElementName="UsageTrack" Path="ActualWidth" />
                                                            <Binding Path="UsagePercent" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:F0}% used}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Free"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Total"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Free}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding Total}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ItemsControl.Template>
                            </ItemsControl>
                            <TextBlock Text="No drives detected."
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SystemInfo.LogicalDrives.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Modules at a Glance"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding ModuleSummaries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"
                                     Rows="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8"
                                Padding="16"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LastScanSummary}"
                                           FontSize="12"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding LastScannedDisplay}"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
