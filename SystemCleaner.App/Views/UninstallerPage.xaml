<UserControl x:Class="SystemCleaner.App.Views.UninstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <Border Grid.Row="0"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="16"
        Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            Width="360"
                            VerticalAlignment="Center">
                    <Image Width="24"
                           Height="24"
                           Margin="0,0,8,0"
                           Source="https://img.icons8.com/ios-filled/50/c62828/uninstall-program.png" />
                    <TextBox Width="220"
                             Height="32"
                             Margin="0,0,16,0"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             Text="{Binding Uninstaller.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search applications" />
                    <TextBlock Text="{Binding Uninstaller.Applications.Count, StringFormat=Status: {0} apps}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{Binding Uninstaller.WindowsAppsToggleLabel}"
                            Style="{DynamicResource ToolbarButtonStyle}"
                            Command="{Binding Uninstaller.ToggleWindowsAppsCommand}" />
                    <Button Content="{Binding Uninstaller.MonitorToggleLabel}"
                            Style="{DynamicResource ToolbarButtonStyle}"
                            Command="{Binding Uninstaller.ToggleMonitorCommand}" />
                    <Button Content="Refresh"
                            Style="{DynamicResource ToolbarButtonStyle}"
                            Command="{Binding Uninstaller.RefreshCommand}" />
                    <Button Content="Uninstall"
                            Style="{DynamicResource ToolbarAccentButtonStyle}"
                            Command="{Binding Uninstaller.UninstallCommand}" />
                    <Button Content="Force Uninstall"
                            Style="{DynamicResource ToolbarAccentButtonStyle}"
                            Margin="0"
                            Command="{Binding Uninstaller.ForceUninstallCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="8">
            <DataGrid ItemsSource="{Binding Uninstaller.ApplicationsView}"
                      SelectedItem="{Binding Uninstaller.SelectedApplication, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      RowHeight="32"
                      Background="{DynamicResource CardBrush}"
                      BorderThickness="0"
                      RowBackground="{DynamicResource SurfaceAltBrush}"
                      AlternatingRowBackground="Transparent"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Width="40" />
                    <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="220" />
                    <DataGridTextColumn Binding="{Binding Publisher}" Header="Publisher" Width="200" />
                    <DataGridTextColumn Binding="{Binding Version}" Header="Version" Width="120" />
                    <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="Size" Width="110" />
                    <DataGridTextColumn Binding="{Binding InstallDateDisplay}" Header="Install Date" Width="140" />
                    <DataGridTextColumn Binding="{Binding InstallLocation}" Header="Location" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
        <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16"
                        Visibility="{Binding Uninstaller.HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Detected Residual Items"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Powerful Scan"
                                    Width="140"
                                    Style="{DynamicResource ToolbarAccentButtonStyle}"
                                    Command="{Binding Uninstaller.PowerfulScanCommand}" />
                            <Button Content="Cleanup Residuals"
                                    Width="140"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    Margin="0"
                                    Command="{Binding Uninstaller.CleanupResidualsCommand}" />
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding Uninstaller.ResidualItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="28"
                                  Background="{DynamicResource CardBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  RowBackground="{DynamicResource SurfaceAltBrush}"
                                  AlternatingRowBackground="Transparent"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Width="40" />
                                <DataGridTextColumn Binding="{Binding ApplicationName}" Header="Application" Width="200" />
                                <DataGridTextColumn Binding="{Binding KindDisplay}" Header="Type" Width="140" />
                                <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="Size" Width="120" />
                                <DataGridTextColumn Binding="{Binding Source}" Header="Source" Width="150" />
                                <DataGridTextColumn Binding="{Binding Path}" Header="Path" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

        <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16"
            Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Browser Plug-ins"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <ListBox ItemsSource="{Binding Uninstaller.BrowserExtensions}"
                                 SelectedItem="{Binding Uninstaller.SelectedExtension, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Margin="0,8,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Browser}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Location}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Remove"
                                Width="110"
                                Style="{DynamicResource ToolbarButtonStyle}"
                                Command="{Binding Uninstaller.RemoveExtensionCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
        <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
                    <StackPanel>
                        <TextBlock Text="Software Health Insights"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding Uninstaller.HealthInsights}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Message}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button Content="Open Install Folder"
                                    Width="160"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    Command="{Binding Uninstaller.OpenInstallLocationCommand}" />
                            <Button Content="Open Registry"
                                    Width="140"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding Uninstaller.OpenRegistryKeyCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

        <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16"
            Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Monitor Status"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Uninstaller.InstallMonitorStatus}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Uninstaller.ResidualStatus}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.RowSpan="3"
                Background="#B3000000"
                Visibility="{Binding Uninstaller.IsBusy, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="20"
                IsHitTestVisible="True">
        <Border Background="{DynamicResource CardBrush}"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.45" ShadowDepth="2" />
                </Border.Effect>
                <StackPanel Width="260"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,0,0,16"
                                 Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Managing applications..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Uninstaller.StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
