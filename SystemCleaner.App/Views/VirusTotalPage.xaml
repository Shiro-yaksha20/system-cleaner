<UserControl x:Class="SystemCleaner.App.Views.VirusTotalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
            <Border Margin="0,0,0,20"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasApiKey}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Add your personal VirusTotal API key in Settings to enable scanning."
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Free keys have strict rate limits; each user should supply their own."
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Submit for Analysis"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,16,0,0"
                                VerticalAlignment="Center">
                        <TextBox Width="360"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedFilePath}"
                                 ToolTip="Selected file path"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource SurfaceBrush}" />
                        <Button Content="Browse"
                                Margin="12,0,0,0"
                                Style="{DynamicResource ToolbarButtonStyle}"
                                Command="{Binding BrowseFileCommand}" />
                        <Button Content="Scan File"
                                Margin="12,0,0,0"
                                Style="{DynamicResource ToolbarAccentButtonStyle}"
                                Command="{Binding ScanFileCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0"
                                VerticalAlignment="Center">
                        <TextBox Width="360"
                                 Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter a URL to analyze"
                                 VerticalContentAlignment="Center" />
                        <Button Content="Scan URL"
                                Margin="12,0,0,0"
                                Style="{DynamicResource ToolbarAccentButtonStyle}"
                                Command="{Binding ScanUrlCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Recent Submissions"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <ListView Margin="0,8,0,0"
                                  ItemsSource="{Binding History}"
                                  SelectedItem="{Binding SelectedSubmission, Mode=TwoWay}"
                                  BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding SubmittedAt, StringFormat={}{0:G}}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Margin="0,8,0,0"
                                   Text="No submissions yet. Scan a file or URL to see results here."
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding History.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,16"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SelectedSubmission, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Analysis Details"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Button Content="Refresh"
                                    Margin="12,0,0,0"
                                    Style="{DynamicResource ToolbarButtonStyle}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Padding="16"
                                CornerRadius="10"
                                Visibility="{Binding SelectedSubmission, Converter={StaticResource NullToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSubmission.HasDetections}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedSubmission.DetectionRatio}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Margin="0,0,24,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSubmission.HasDetections}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SelectedSubmission.DetectionHeadline}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding SelectedSubmission.DetectionDetails}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding SelectedSubmission, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedSubmission.DisplayName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SelectedSubmission.FileTypeDisplay}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Submitted:" FontWeight="SemiBold" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding SelectedSubmission.SubmittedAtDisplay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBlock Text="File size:" FontWeight="SemiBold" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding SelectedSubmission.SizeDisplay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBlock Text="Engines:" FontWeight="SemiBold" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding SelectedSubmission.VendorSummary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBlock Text="Reputation:" FontWeight="SemiBold" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding SelectedSubmission.ReputationDisplay}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding SelectedSubmission.DetectionDetails}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="SHA-256:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedSubmission.Sha256}" Margin="8,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Report:" FontWeight="SemiBold" />
                                <TextBlock Margin="8,0,0,0">
                                    <Hyperlink NavigateUri="{Binding SelectedSubmission.Permalink}"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        <TextBlock Text="Open on virustotal.com" Foreground="{DynamicResource AccentBrush}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding SelectedSubmission, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Tags"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding SelectedSubmission.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,6,6,0"
                                                Padding="8,4"
                                                CornerRadius="12"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSubmission.HasTags}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                            <TextBlock Margin="0,6,0,0"
                                       Text="No tags reported."
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSubmission.HasTags}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="0"
                                   Grid.RowSpan="5"
                                   Text="Choose a submission from the list to view detailed results."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSubmission}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Grid.Row="4"
                                Margin="0,16,0,0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Visibility="{Binding SelectedSubmission, Converter={StaticResource NullToVisibilityConverter}}">
                            <DataGrid ItemsSource="{Binding SelectedSubmission.Engines}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="2*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0"
                        VerticalAlignment="Center">
                <Border Width="260"
                        Height="14"
                        CornerRadius="7"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True"
                                 Margin="1"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="Transparent"
                                 BorderThickness="0" />
                </Border>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <Button Content="Cancel"
                        Margin="12,0,0,0"
                        Style="{DynamicResource ToolbarButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="16"
                Padding="10,6"
                CornerRadius="12"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Cursor="Hand"
                Visibility="{Binding HasQuotaInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                ToolTipService.InitialShowDelay="120"
                ToolTipService.ShowDuration="60000">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Quota"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text=":"
                           Margin="6,0,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding QuotaSummary}"
                           Margin="4,0,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220" />
            </StackPanel>
            <Border.ToolTip>
                <ToolTip Placement="Top"
                         Padding="12"
                         Background="{DynamicResource SurfaceAltBrush}"
                         BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="VirusTotal Quota"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding QuotaSummary}"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <Separator Margin="0,8,0,8" />
                        <TextBlock Text="{Binding QuotaDetails}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="260" />
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
        </Border>
    </Grid>
</UserControl>
