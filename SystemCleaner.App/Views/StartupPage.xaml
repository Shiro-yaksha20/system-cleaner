<UserControl x:Class="SystemCleaner.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
         <Image Width="24"
             Height="24"
             Margin="0,0,8,0"
             Source="https://img.icons8.com/ios-filled/50/3f8bff/settings.png" />
            <TextBlock Text="Startup Status:"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding StartupManager.StatusMessage}"
                       FontWeight="Bold"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,0,0,0">
                <Button Content="Open Location"
                        Width="140"
                        Style="{DynamicResource SmallToolbarButtonStyle}"
                        Command="{Binding StartupManager.OpenEntryLocationCommand}" />
                <Button Content="Refresh"
                        Width="110"
                        Style="{DynamicResource SmallToolbarButtonStyle}"
                        Margin="0"
                        Command="{Binding StartupManager.RefreshCommand}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="8">
            <DataGrid ItemsSource="{Binding StartupManager.Entries}"
                      SelectedItem="{Binding StartupManager.SelectedEntry, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      RowHeight="32"
                      Background="{DynamicResource CardBrush}"
                      BorderThickness="0"
                      RowBackground="{DynamicResource SurfaceAltBrush}"
                      AlternatingRowBackground="Transparent"
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding SupportsToggle}">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTogglePending}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Name}" Header="App Name" Width="220" />
                    <DataGridTextColumn Binding="{Binding Location}" Header="Publisher" Width="200" />
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Width="52"
                                              Height="22"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding SupportsToggle}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTogglePending}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder"
                                                    Width="52"
                                                    Height="22"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="11">
                                                <Grid>
                                                    <Ellipse x:Name="Thumb"
                                                             Width="20"
                                                             Height="20"
                                                             Fill="White"
                                                             Margin="1"
                                                             HorizontalAlignment="Left" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="ToggleBorder"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Thumb"
                                                            Property="HorizontalAlignment"
                                                            Value="Right" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Confirmation" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceAltBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Checking..." />
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerificationStatus}" Value="Unknown">
                                                        <Setter Property="Text" Value="Awaiting" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VerificationStatus}" Value="Match">
                                                        <Setter Property="Text" Value="Confirmed" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VerificationStatus}" Value="Mismatch">
                                                        <Setter Property="Text" Value="Mismatch" />
                                                        <Setter Property="Foreground" Value="#FFD9534F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Command}" Header="Command" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
