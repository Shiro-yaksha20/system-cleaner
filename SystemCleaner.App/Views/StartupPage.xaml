<UserControl x:Class="SystemCleaner.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
         <Image Width="24"
             Height="24"
             Margin="0,0,8,0"
             Source="https://img.icons8.com/ios-filled/50/3f8bff/settings.png" />
            <TextBlock Text="Startup Status:"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding StartupManager.StatusMessage}"
                       FontWeight="Bold"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,0,0,0">
                <Button Content="Open Location"
                        Width="140"
                        Style="{DynamicResource SmallToolbarButtonStyle}"
                        Command="{Binding StartupManager.OpenEntryLocationCommand}" />
                <Button Content="Refresh"
                        Width="110"
                        Style="{DynamicResource SmallToolbarButtonStyle}"
                        Margin="0"
                        Command="{Binding StartupManager.RefreshCommand}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        Padding="12"
                        CornerRadius="10"
                        Background="#1FFF8C42"
                        BorderBrush="#33FF8C42"
                        BorderThickness="1"
                        Visibility="{Binding StartupManager.HasIssues, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Windows reported startup access issues"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding StartupManager.Issues}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,2,0,2">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Margin="0,6,8,0" />
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding StartupManager.Entries}"
                              SelectedItem="{Binding StartupManager.SelectedEntry, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeight="32"
                              Background="{DynamicResource CardBrush}"
                              BorderThickness="0"
                              RowBackground="{DynamicResource SurfaceAltBrush}"
                              AlternatingRowBackground="Transparent"
                              GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Header="App Name" Width="220" />
                    <DataGridTextColumn Binding="{Binding Scope}" Header="Scope" Width="180" />
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Width="52"
                                              Height="22"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding SupportsToggle}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="ToolTip" Value="Toggle startup state" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTogglePending}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="Applying change..." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SupportsToggle}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                    <Setter Property="ToolTip" Value="Windows did not expose a toggle for this entry." />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SupportsToggle}" Value="True" />
                                                        <Condition Binding="{Binding RequiresElevation}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="ToolTip" Value="Administrator permission may be required to edit this entry." />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder"
                                                    Width="52"
                                                    Height="22"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="11">
                                                <Grid>
                                                    <Ellipse x:Name="Thumb"
                                                             Width="20"
                                                             Height="20"
                                                             Fill="White"
                                                             Margin="1"
                                                             HorizontalAlignment="Left" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="ToggleBorder"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Thumb"
                                                            Property="HorizontalAlignment"
                                                            Value="Right" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Confirmation" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceAltBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Checking..." />
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerificationStatus}" Value="Unknown">
                                                        <Setter Property="Text" Value="Awaiting" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VerificationStatus}" Value="Match">
                                                        <Setter Property="Text" Value="Confirmed" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VerificationStatus}" Value="Mismatch">
                                                        <Setter Property="Text" Value="Mismatch" />
                                                        <Setter Property="Foreground" Value="#FFD9534F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Command}" Header="Command" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
                    <Border Background="#CC0F1119"
                            CornerRadius="12"
                            Visibility="{Binding StartupManager.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Width="240">
                            <ProgressBar IsIndeterminate="True"
                                         Height="6"
                                         Margin="0,0,0,12" />
                            <TextBlock Text="Scanning startup entries..."
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="360">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding StartupManager.IsBusy}" Value="False" />
                                            <Condition Binding="{Binding StartupManager.HasEntries}" Value="False" />
                                            <Condition Binding="{Binding StartupManager.HasIssues}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Width="64"
                               Height="64"
                               Source="https://img.icons8.com/fluency/96/sleeping-in-bed.png"
                               Margin="0,0,0,12" />
                        <TextBlock Text="No startup entries are available to manage."
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Try running System Cleaner as administrator or installing new apps that register startup commands."
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
