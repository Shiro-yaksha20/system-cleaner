<Window x:Class="SystemCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SystemCleaner.App.Views"
        xmlns:local="clr-namespace:SystemCleaner.App.ViewModels"
        mc:Ignorable="d"
        Title="System Cleaner"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            UseAeroCaptionButtons="False"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarAccentButtonStyle"
               BasedOn="{StaticResource ToolbarButtonStyle}"
               TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallToolbarButtonStyle"
               BasedOn="{StaticResource ToolbarButtonStyle}"
               TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="4,4,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LightIcon"
                                           Text=""
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="DarkIcon"
                                           Grid.Column="1"
                                           Text=""
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                <Border x:Name="Thumb"
                                        Width="32"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="0">
                                    <Grid>
                                        <TextBlock x:Name="ThumbIcon"
                                                   Text=""
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="ThumbIcon" Property="Text" Value="" />
                                <Setter TargetName="LightIcon" Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                                <Setter TargetName="DarkIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="ThumbIcon" Property="Text" Value="" />
                                <Setter TargetName="LightIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="DarkIcon" Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2" />
                                </Grid.RowDefinitions>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                <Border x:Name="Indicator"
                                        Grid.Row="1"
                                        Height="3"
                    Background="Transparent"
                    Opacity="0"
                                        CornerRadius="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Overview}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Overview}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.SystemInfo}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.SystemInfo}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Cleaning}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Cleaning}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Startup}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Startup}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Uninstaller}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Uninstaller}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.VirusTotal}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.VirusTotal}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Settings}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Settings}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverviewPageVisibilityStyle" TargetType="views:OverviewPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Overview}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SystemInfoPageVisibilityStyle" TargetType="views:SystemInfoPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.SystemInfo}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleaningPageVisibilityStyle" TargetType="views:CleaningPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Cleaning}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartupPageVisibilityStyle" TargetType="views:StartupPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Startup}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UninstallerPageVisibilityStyle" TargetType="views:UninstallerPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Uninstaller}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VirusTotalPageVisibilityStyle" TargetType="views:VirusTotalPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.VirusTotal}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsPageVisibilityStyle" TargetType="views:SettingsPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Settings}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              Opacity="0.25"
                              ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Padding="20,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Overview"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Overview}"
                Tag="{x:Static local:MainTab.Overview}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="System Info"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.SystemInfo}"
                Tag="{x:Static local:MainTab.SystemInfo}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Cleaning"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Cleaning}"
                Tag="{x:Static local:MainTab.Cleaning}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Startup"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Startup}"
                Tag="{x:Static local:MainTab.Startup}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Uninstaller"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Uninstaller}"
                Tag="{x:Static local:MainTab.Uninstaller}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="VirusTotal"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.VirusTotal}"
                Tag="{x:Static local:MainTab.VirusTotal}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Settings"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Settings}"
                Tag="{x:Static local:MainTab.Settings}" />
            </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton Style="{StaticResource ThemeToggleStyle}"
                                      IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                      ToolTip="Toggle light or dark theme" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="-"
                                Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="[]"
                                Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="X"
                                Background="#E81123"
                                Foreground="White"
                                Margin="0"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="Transparent">
                <views:OverviewPage Style="{StaticResource OverviewPageVisibilityStyle}" />
                <views:SystemInfoPage Style="{StaticResource SystemInfoPageVisibilityStyle}" />
                <views:CleaningPage Style="{StaticResource CleaningPageVisibilityStyle}" />
                <views:StartupPage Style="{StaticResource StartupPageVisibilityStyle}" />
                <views:UninstallerPage Style="{StaticResource UninstallerPageVisibilityStyle}" />
                <views:VirusTotalPage DataContext="{Binding VirusTotal}"
                                       Style="{StaticResource VirusTotalPageVisibilityStyle}" />
                <views:SettingsPage Style="{StaticResource SettingsPageVisibilityStyle}" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Scan"
                                Command="{Binding ScanCommand}" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Clean"
                                Command="{Binding CleanCommand}"
                                Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalSelectedDisplay, StringFormat=Selection Size: {0}}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.RowSpan="3"
                    Background="#B3000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="50"
                    IsHitTestVisible="True"
                    CornerRadius="12">
        <Border Background="{DynamicResource CardBrush}"
                        CornerRadius="10"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.45" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="240">
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     Margin="0,0,0,16"
                                     Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Working..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Content="Cancel"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding CancelCommand}"
                                Margin="0,16,0,0"
                                IsEnabled="{Binding IsBusy}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
