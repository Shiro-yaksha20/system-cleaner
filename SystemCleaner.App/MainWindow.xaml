<Window x:Class="SystemCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SystemCleaner.App.Views"
        xmlns:local="clr-namespace:SystemCleaner.App.ViewModels"
        mc:Ignorable="d"
        Title="System Cleaner"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            UseAeroCaptionButtons="False"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Switch between light and dark themes" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="4"
                                    SnapsToDevicePixels="True" />
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Grid.Column="0">
                                    <TextBlock x:Name="SunLabel"
                                               Text="☀"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="14"
                                               Opacity="0.95"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <TextBlock Text="Day"
                                               Margin="6,0,0,0"
                                               FontSize="12"
                                               Opacity="0.8"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Grid.Column="1">
                                    <TextBlock x:Name="MoonLabel"
                                               Text="☾"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="14"
                                               Opacity="0.35"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <TextBlock Text="Night"
                                               Margin="6,0,0,0"
                                               FontSize="12"
                                               Opacity="0.45"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="Thumb"
                                    Width="40"
                                    Height="24"
                                    CornerRadius="14"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="4,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" />
                                </Border.RenderTransform>
                                <TextBlock x:Name="ThumbIcon"
                                           Text="☀"
                                           FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="CheckedStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="44"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="CheckedStoryboard" />
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ThumbIcon" Property="Text" Value="☾" />
                                <Setter TargetName="SunLabel" Property="Opacity" Value="0.4" />
                                <Setter TargetName="MoonLabel" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="UncheckedStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="UncheckedStoryboard" />
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="ThumbIcon" Property="Text" Value="☀" />
                                <Setter TargetName="SunLabel" Property="Opacity" Value="0.95" />
                                <Setter TargetName="MoonLabel" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="ActiveGlow"
                                        Grid.RowSpan="2"
                                        Margin="2,4,0,4"
                                        Width="4"
                                        Opacity="0"
                                        Background="{DynamicResource AccentGlowBrush}"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Border x:Name="Indicator"
                                        Grid.Row="1"
                                        Height="4"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0.25"
                                        CornerRadius="2"
                                        Margin="8,2,8,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.8" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Overview}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Overview}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.8" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.SystemInfo}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.SystemInfo}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.8" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Cleaning}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Cleaning}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.8" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Startup}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Startup}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.8" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Uninstaller}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Uninstaller}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.8" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.VirusTotal}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.VirusTotal}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.8" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedTab}" Value="{x:Static local:MainTab.Settings}" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:MainTab.Settings}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.8" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverviewPageVisibilityStyle" TargetType="views:OverviewPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.Overview}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SystemInfoPageVisibilityStyle" TargetType="views:SystemInfoPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.SystemInfo}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleaningPageVisibilityStyle" TargetType="views:CleaningPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.Cleaning}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartupPageVisibilityStyle" TargetType="views:StartupPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.Startup}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UninstallerPageVisibilityStyle" TargetType="views:UninstallerPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.Uninstaller}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VirusTotalPageVisibilityStyle" TargetType="views:VirusTotalPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.VirusTotal}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsPageVisibilityStyle" TargetType="views:SettingsPage">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static local:MainTab.Settings}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            Margin="12"
            Padding="8"
            CornerRadius="12"
            Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              Opacity="0.25"
                              ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="64" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Padding="20,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,24,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Overview"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Overview}"
                Tag="{x:Static local:MainTab.Overview}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="System Info"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.SystemInfo}"
                Tag="{x:Static local:MainTab.SystemInfo}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Cleaning"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Cleaning}"
                Tag="{x:Static local:MainTab.Cleaning}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Startup"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Startup}"
                Tag="{x:Static local:MainTab.Startup}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Uninstaller"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Uninstaller}"
                Tag="{x:Static local:MainTab.Uninstaller}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="VirusTotal"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.VirusTotal}"
                Tag="{x:Static local:MainTab.VirusTotal}" />
            <Button Style="{StaticResource MainTabButtonStyle}"
                Content="Settings"
                Command="{Binding ChangeTabCommand}"
                CommandParameter="{x:Static local:MainTab.Settings}"
                Tag="{x:Static local:MainTab.Settings}" />
            </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton Style="{StaticResource ThemeToggleStyle}"
                                      IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                      ToolTip="Toggle light or dark theme" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="-"
                                Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="[]"
                                Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="X"
                                Background="#E81123"
                                Foreground="White"
                                Margin="0"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="20,8,20,0"
                    Padding="16,10"
                    CornerRadius="8"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveNotification}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveNotification.Severity}" Value="Warning">
                                <Setter Property="Background" Value="#FFFDF5E6" />
                                <Setter Property="BorderBrush" Value="#FFE1A500" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveNotification.Severity}" Value="Error">
                                <Setter Property="Background" Value="#FFF8E6E8" />
                                <Setter Property="BorderBrush" Value="#FFD13438" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid DataContext="{Binding ActiveNotification}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="Background" Value="#FFE1A500" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Background" Value="#FFD13438" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Text" Value="" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Text" Value="" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding Message}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:MMM dd, h:mm tt}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Dismiss"
                            Style="{StaticResource SmallToolbarButtonStyle}"
                            Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Background="Transparent">
                <views:OverviewPage Style="{StaticResource OverviewPageVisibilityStyle}" />
                <views:SystemInfoPage Style="{StaticResource SystemInfoPageVisibilityStyle}" />
                <views:CleaningPage DataContext="{Binding Cleanup}"
                                    Style="{StaticResource CleaningPageVisibilityStyle}" />
                <views:StartupPage Style="{StaticResource StartupPageVisibilityStyle}" />
                <views:UninstallerPage Style="{StaticResource UninstallerPageVisibilityStyle}" />
                <views:VirusTotalPage DataContext="{Binding VirusTotal}"
                                       Style="{StaticResource VirusTotalPageVisibilityStyle}" />
                <views:SettingsPage Style="{StaticResource SettingsPageVisibilityStyle}" />
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,8"
                    Margin="0,12,0,0"
                    MinHeight="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Scan"
                                Command="{Binding Cleanup.ScanCommand}" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Clean"
                                Command="{Binding Cleanup.CleanCommand}"
                                Margin="12,0,0,0" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Quick Clean"
                                Command="{Binding Cleanup.QuickCleanCommand}"
                                Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <TextBlock Text="{Binding Cleanup.StatusMessage}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Text="{Binding Cleanup.LastScanSummary}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Cleanup.TotalSelectedDisplay, StringFormat=Selection Size: {0}}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Uninstaller">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Uninstaller.SelectedSizeDisplay, StringFormat=Selection Size: {0}}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Uninstaller">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Cleanup.PendingCleanupItemCount, StringFormat=Pending Items: {0}}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

                <Border Grid.RowSpan="4"
                    Background="#B3000000"
                    Visibility="{Binding Cleanup.IsBusy, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="50"
                    IsHitTestVisible="True"
                    CornerRadius="{Binding CornerRadius, ElementName=ShellBorder}">
        <Border Background="{DynamicResource CardBrush}"
                        CornerRadius="10"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Opacity="0.45" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="240">
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     Margin="0,0,0,16"
                                     Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Working..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Cleanup.StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Content="Cancel"
                                Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding Cleanup.CancelCommand}"
                                Margin="0,16,0,0"
                            IsEnabled="{Binding Cleanup.IsBusy}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
