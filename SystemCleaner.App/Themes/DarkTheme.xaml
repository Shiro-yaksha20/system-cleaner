<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#FF5BA8FF</Color>
    <Color x:Key="AccentColor">#FF3F8BFF</Color>
    <Color x:Key="AccentHoverColor">#FF57A1FF</Color>
    <Color x:Key="SurfaceColor">#FF0F172A</Color>
    <Color x:Key="SurfaceAltColor">#FF172235</Color>
    <Color x:Key="CardColor">#FF1D2C44</Color>
    <Color x:Key="BorderColor">#FF23344D</Color>
    <Color x:Key="ForegroundColor">#FFE8F1FF</Color>
    <Color x:Key="SecondaryForegroundColor">#FF9DB4D7</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#303F8BFF" />
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0A1220" Offset="0.0" />
        <GradientStop Color="#FF0F192B" Offset="0.45" />
        <GradientStop Color="#FF121F35" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryForegroundColor}" />

    <SolidColorBrush x:Key="GaugeInnerBrush" Color="#141D2D" />
    <SolidColorBrush x:Key="GaugeInnerStrokeBrush" Color="#33000000" />
    <SolidColorBrush x:Key="GaugeInfoPillBrush" Color="#1A102035" />
    <SolidColorBrush x:Key="GaugeInfoPillBorderBrush" Color="#FF23344D" />
</ResourceDictionary>
