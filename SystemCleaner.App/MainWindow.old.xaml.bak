<Window x:Class="SystemCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="http://schemas.microsoft.com/winfx/2006/xaml/presentation/shell"
        mc:Ignorable="d"
        Title="System Cleaner"
        Width="1100"
        Height="650"
        MinWidth="950"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            UseAeroCaptionButtons="False"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D7" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#222222" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555555" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D0D0D0" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#E1E1E1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarAccentButtonStyle" BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SmallToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#E1E1E1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6D6D6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="Margin" Value="20,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="HeaderContainer" Background="Transparent" Padding="0" Margin="0,0,0,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="AccentBar" Height="2" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#111111" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate TargetType="TabControl" x:Key="ModernTabControlTemplate">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E8E8E8" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TabPanel x:Name="HeaderPanel"
                                  Grid.Column="0"
                                  Margin="20,0,0,0"
                                  Background="Transparent"
                                  IsItemsHost="True"
                                  VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Content="−"
                                    Click="MinimizeButton_Click" />
                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Content="❐"
                                    Click="MaximizeButton_Click" />
                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Content="✕"
                                    Click="CloseButton_Click"
                                    Background="#E81123"
                                    Foreground="White"
                                    Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="Transparent">
                    <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0" ContentSource="SelectedContent" />
                </Border>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ListBoxItem" x:Key="ModuleListItemStyle">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A0078D7" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#100078D7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F3F3F3">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="16" Background="{DynamicResource SurfaceAltBrush}">
            <TabItem Header="Overview">
                <ScrollViewer Background="{DynamicResource SurfaceBrush}">
                    <StackPanel Margin="16">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Last Scan" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastScanSummary}" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Run Scan" Command="{Binding ScanCommand}" Width="120" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Quick Clean" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastQuickCleanSummary}" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Run Quick Clean" Command="{Binding QuickCleanCommand}" Width="160" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Modules at a Glance" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <ItemsControl ItemsSource="{Binding ModuleSummaries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,12" Width="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Description}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                            <TextBlock Text="{Binding LastScanSummary}" Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding LastScannedDisplay, StringFormat=Last scanned: {0}}" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                            <TextBlock Text="{Binding QuickCleanGuidance}" Margin="0,8,0,0" FontStyle="Italic" />
                                            <TextBlock Text="{Binding Warning}" Margin="0,6,0,0" Foreground="#FFD6894C" Visibility="{Binding Warning, Converter={StaticResource NullToVisibilityConverter}}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Cleaning">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
                        <DockPanel>
                            <TextBlock Text="Cleanup Areas" FontWeight="SemiBold" Padding="12" />
                            <ListBox ItemsSource="{Binding Modules}"
                                     SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                                     DisplayMemberPath="Name"
                                     Margin="12"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="180" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="16,16,16,0">
                                <TextBlock Text="{Binding SelectedModule.Name}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedModule.Description}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                <TextBlock Text="{Binding SelectedModule.Warning}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FFD6894C" FontStyle="Italic" Visibility="{Binding SelectedModule.Warning, Converter={StaticResource NullToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Module Total" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedModule.TotalSizeDisplay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Margin="24,0,0,0">
                                        <TextBlock Text="Selected" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedModule.SelectedSizeDisplay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8">
                                <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                                <Button Content="Clear Selection" Command="{Binding DeselectAllCommand}" Margin="0,0,8,0" />
                                <Button Content="Open Location" Command="{Binding OpenItemLocationCommand}" />
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding SelectedModule.Items}"
                                      SelectedItem="{Binding SelectedModule.SelectedItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Margin="16"
                                      IsReadOnly="False"
                                      HeadersVisibility="Column"
                                      RowBackground="{DynamicResource SurfaceBrush}"
                                      AlternatingRowBackground="{DynamicResource SurfaceAltBrush}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Header="" Width="40" />
                                    <DataGridTextColumn Binding="{Binding DisplayName}" Header="Item" Width="200" />
                                    <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="Size" Width="120" />
                                    <DataGridTextColumn Binding="{Binding Path}" Header="Path" Width="*" />
                                    <DataGridTextColumn Binding="{Binding RequiresElevation}" Header="Admin" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="3" Margin="16" Padding="12" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="Activity Log" FontWeight="SemiBold" DockPanel.Dock="Top" />
                                    <ListBox ItemsSource="{Binding LogEntries}" Margin="0,8,0,0" BorderThickness="0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Startup">
                <Border Background="{DynamicResource SurfaceBrush}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StartupManager.StatusMessage}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Open Location" Command="{Binding StartupManager.OpenEntryLocationCommand}" Margin="0,0,8,0" />
                            <Button Content="Refresh" Command="{Binding StartupManager.RefreshCommand}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding StartupManager.Entries}"
                                  SelectedItem="{Binding StartupManager.SelectedEntry, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Margin="0,12,0,0"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="220" />
                                <DataGridTextColumn Binding="{Binding Location}" Header="Location" Width="160" />
                                <DataGridTextColumn Binding="{Binding Command}" Header="Command" Width="*" />
                                <DataGridCheckBoxColumn Binding="{Binding IsEnabled, Mode=OneWay}" Header="Enabled" Width="90" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Uninstaller">
                <Grid Background="{DynamicResource SurfaceBrush}" Margin="16">
                    <Grid.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
                        <Style x:Key="PrimaryActionButton" TargetType="Button">
                            <Setter Property="MinWidth" Value="96" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                        <Style TargetType="TextBlock" x:Key="SectionHeading">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBox Width="220"
                                     Height="28"
                                     Margin="0,0,12,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Uninstaller.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by application name or publisher" />
                            <StackPanel>
                                <TextBlock Text="{Binding Uninstaller.Applications.Count, StringFormat=Applications loaded: {0}}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Uninstaller.StatusMessage}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                <TextBlock Text="{Binding Uninstaller.InstallMonitorStatus}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="{Binding Uninstaller.WindowsAppsToggleLabel}"
                                    Command="{Binding Uninstaller.ToggleWindowsAppsCommand}" />
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="{Binding Uninstaller.MonitorToggleLabel}"
                                    Command="{Binding Uninstaller.ToggleMonitorCommand}" />
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="Refresh"
                                    Command="{Binding Uninstaller.RefreshCommand}" />
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="Uninstall"
                                    Command="{Binding Uninstaller.UninstallCommand}" />
                <Button Style="{StaticResource PrimaryActionButton}"
                    Margin="0"
                    Content="Force Uninstall"
                    Command="{Binding Uninstaller.ForceUninstallCommand}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Uninstaller.ApplicationsView}"
                              SelectedItem="{Binding Uninstaller.SelectedApplication, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Margin="0,12,0,12"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              GridLinesVisibility="Horizontal"
                              RowHeight="32"
                              AlternationCount="2"
                              SnapsToDevicePixels="True"
                              IsSynchronizedWithCurrentItem="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Header="" Width="40" />
                            <DataGridTextColumn Binding="{Binding Name}" Header="Application" Width="240" IsReadOnly="True" SortMemberPath="Name" />
                            <DataGridTextColumn Binding="{Binding Publisher}" Header="Publisher" Width="180" IsReadOnly="True" SortMemberPath="Publisher" />
                            <DataGridTextColumn Binding="{Binding Version}" Header="Version" Width="120" IsReadOnly="True" SortMemberPath="Version" />
                            <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="Size" Width="100" IsReadOnly="True" SortMemberPath="Application.EstimatedSizeBytes" />
                            <DataGridTextColumn Binding="{Binding InstallDateDisplay}" Header="Installed" Width="130" IsReadOnly="True" SortMemberPath="Application.InstallDate" />
                            <DataGridTextColumn Binding="{Binding InstallLocation}" Header="Location" Width="*" IsReadOnly="True" SortMemberPath="InstallLocation" />
                        </DataGrid.Columns>
                    </DataGrid>

            <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12"
                Background="{DynamicResource SurfaceAltBrush}"
                CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Visibility="{Binding Uninstaller.HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="160" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Powerful Scan Residuals" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Text="{Binding Uninstaller.ResidualStatus}" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryActionButton}" Content="Powerful Scan" Command="{Binding Uninstaller.PowerfulScanCommand}" />
                                    <Button Style="{StaticResource PrimaryActionButton}" Content="Cleanup Residuals" Command="{Binding Uninstaller.CleanupResidualsCommand}" />
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Uninstaller.ResidualItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Margin="0,12,0,0"
                                      IsReadOnly="False"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Header="" Width="40" />
                                    <DataGridTextColumn Binding="{Binding ApplicationName}" Header="Application" Width="200" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding KindDisplay}" Header="Type" Width="120" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="Size" Width="120" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Source}" Header="Source" Width="160" IsReadOnly="True" />
                                    <DataGridTextColumn Binding="{Binding Path}" Header="Path" Width="*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Browser Plug-ins" Style="{StaticResource SectionHeading}" />
                                    <Button Style="{StaticResource PrimaryActionButton}" Content="Remove" Command="{Binding Uninstaller.RemoveExtensionCommand}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Uninstaller.BrowserExtensions}"
                                         SelectedItem="{Binding Uninstaller.SelectedExtension, Mode=TwoWay}"
                                         Margin="0,8,0,0"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Browser}" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                                <TextBlock Text="{Binding Location}" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Software Health" Style="{StaticResource SectionHeading}" />
                                    <Button Style="{StaticResource PrimaryActionButton}" Content="Open Install Folder" Command="{Binding Uninstaller.OpenInstallLocationCommand}" />
                                    <Button Style="{StaticResource PrimaryActionButton}" Content="Open Registry" Command="{Binding Uninstaller.OpenRegistryKeyCommand}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Uninstaller.HealthInsights}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalSelectedDisplay, StringFormat=Total Selected: {0}}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Scan" Command="{Binding ScanCommand}" Padding="18,8" Margin="0,0,12,0" />
                <Button Grid.Column="2" Content="Clean" Command="{Binding CleanCommand}" Padding="18,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
